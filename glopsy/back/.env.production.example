# Copia este archivo a .env en el servidor y completa los valores reales.
# docker compose lo lee automáticamente (el .env real está en .gitignore).
# Genera secretos con: openssl rand -base64 32

DOMAIN=tu-dominio.com

# ---------------------------------------------------------------------------
# Multi-tienda con subdominios (Opción B): token de Cloudflare para registrar
# automáticamente <tienda>.DOMAIN como Workers Custom Domain (DNS + cert auto).
# CLOUDFLARE_API_TOKEN=<token con Workers Scripts / Custom Domains>
# CLOUDFLARE_ACCOUNT_ID=<id de cuenta cloudflare>
# WORKER_SERVICE=glopsy
# STORE_DOMAIN_SUFFIX=glopsy.shop        # root por defecto; cada país puede
#                                        # sobreescribirlo con paises.dominio_raiz
# COOKIE_DOMAIN=glopsy.shop              # sesión compartida entre subdominios
# ---------------------------------------------------------------------------

# Origen del panel de monitoreo (separar con comas si hay varios)
DASHBOARD_ORIGIN=

DB_USER=glopsy
DB_PASSWORD=genera-una-contrasena-fuerte
DB_NAME=glopsy

JWT_SECRET=genera-uno-con-openssl-rand-base64-32
# CLAVE MAESTRA de cifrado. Usar openssl rand -base64 32 y definirla UNA sola vez en Render (dashboard -> Environment).
# NUNCA regenerarla: si cambia, todas las credenciales cifradas guardadas (Mercado Pago, ENVIA, Facebook) quedan inservibles.
APP_ENC_KEY=genera-uno-con-openssl-rand-base64-32

# Cookies httpOnly con Secure (https). Dejar como true.
COOKIE_SECURE=true
# Modo multi-tienda: para compartir la sesión del comprador entre subdominios
# (<tienda>.glopsy.shop) fija el dominio de la cookie del sitio raíz.
# COOKIE_DOMAIN=glopsy.shop

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://glopsy-back.onrender.com/api/auth/google/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://glopsy-back.onrender.com/api/auth/discord/callback

# TikTok OAuth (Login Kit). Client Key = app key en TikTok for Developers.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.glopsy.shop/api/auth/tiktok/callback

# Integraciones (opcionales según lo que uses)
ENVIA_TOKEN=
ENVIA_SHIPPING_API_PROD=
MASTERSHOP_API_URL=
# API key de la cuenta agregadora Mastershop de la plataforma (tienda principal).
# Si no se define, el lookup de producto por Mastershop queda deshabilitado.
MASTERSHOP_API_KEY=

# Cloudflare R2 (almacenamiento de imágenes de producto).
# Crear un token R2 con permiso "Object Read & Write" y derivar:
#   R2_ACCESS_KEY_ID = id del token | R2_SECRET_ACCESS_KEY = SHA-256 del valor del token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=glopsy-products
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://img.glopsy.shop

# Google Analytics 4 (usuarios activos en tiempo real para el monitor)
# Requiere: cuenta de servicio en Google Cloud con acceso al property GA4
# y la API "Google Analytics Data API" habilitada.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Web Push (VAPID) — si no se definen, se usan/generan en config/vapid.json
# Genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# Motor de Marketing (IA opcional sobre reglas)
# Si no defines LLM_API_KEY, el motor funciona SOLO con reglas
# (SEO, promociones, social y email/push) sin llamar a ninguna IA.
# Se usa un endpoint OpenAI-compatible (/chat/completions). Puede apuntar
# a DeepSeek (https://api.deepseek.com) o a un servidor opencode-go propio.
# DEEPSEEK_* se mantiene como respaldo (compatible hacia atrás).
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_MS=8000

# Worker del motor de marketing (análisis automático del catálogo)
# Desactiva con MARKETING_WORKER=off
MARKETING_WORKER=on
MARKETING_INTERVAL_HOURS=6
MARKETING_MAX_PROMOS=8

# ---------------------------------------------------------------------------
# Venezuela (multicountry)
# ---------------------------------------------------------------------------
# ZOOM Envíos (API pública de cotización). Sandbox por defecto; producción:
# https://zoom.red/baaszoom/public/canguroazul (requiere enrolamiento con ZOOM).
ZOOM_API_BASE=https://sandbox.zoom.red/baaszoom/public/canguroazul
# Ciudad de origen por defecto (código ZOOM) si la tienda no la configura.
# Caracas = 19. Ver /api/geo/zoom-ciudades para el catálogo.
ZOOM_DEFAULT_ORIGEN=19

# Tasa USD->VES (bolívares) vía DolarApi.com. Fuente: oficial | paralelo.
DOLARAPI_BASE=https://ve.dolarapi.com/v1/dolares
VE_RATE_SOURCE=oficial
# Respaldo si DolarApi falla (bolívares por 1 USD).
VE_FALLBACK_RATE=
# PayPal se configura POR TIENDA desde el panel (Client ID + Secret), no por env.

# ---------------------------------------------------------------------------
# ePayco (Colombia) - cuenta central de la plataforma (Checkout Onpage)
# ---------------------------------------------------------------------------
# Llave pública del comercio (dashboard ePayco -> Configuración -> Llaves).
EPAYCO_PUBLIC_KEY=
# Llave privada (P_KEY) para verificar la firma MD5 del webhook de confirmación.
EPAYCO_PRIVATE_KEY=
# P_CUST_ID_CLIENTE del comercio (se usa para validar el webhook).
EPAYCO_CUSTOMER_ID=
# --- ePayco Payouts: alta automática de proveedores al crear tienda en /vender ---
# Activar solo cuando la cuenta tenga el producto ePayco Payouts habilitado.
# El token se obtiene por login OAuth (client_credentials con PUBLIC_KEY/PRIVATE_KEY)
# contra $EPAYCO_PAYOUTS_BASE_URL/authentication/api/v2/login; no se configura manual.
# EPAYCO_PAYOUTS_ENABLED=false
# Host de la API de dispersión (apiflow.epayco.io por docs; tu portal usa khepri.epayco.co).
# EPAYCO_PAYOUTS_BASE_URL=https://apiflow.epayco.io
# Override opcional del token (solo si el panel exige otro token distinto al login).
# EPAYCO_PAYOUTS_TOKEN=
# El id_epayco se deriva solo de P_CUST_ID_CLIENTE (lo toma de la tarjeta ePayco). Opcional override:
# EPAYCO_ID_EPAYCO=
# id del plan de proveedores (panel ePayco Payouts, glopsy.epayco.me): OBLIGATORIO.
# EPAYCO_ID_PLAN=
# Categoría económica del proveedor (catálogo DIAN/ePayco). Opcional.
# EPAYCO_PAYOUTS_CATEGORY_ID=0112
# EPAYCO_PAYOUTS_CATEGORY=
# Días hábiles de retención del saldo del proveedor tras la entrega.
LEDGER_HOLD_BUSINESS_DAYS=2

# ---------------------------------------------------------------------------
# Precio local para tiendas habilitadas en USD
# ---------------------------------------------------------------------------
# Tasa USD->COP de respaldo si falla Frankfurter (pesos por 1 USD).
USD_COP_RATE=

