# Copia este archivo a .env en el servidor y completa los valores reales.
# docker compose lo lee automáticamente (el .env real está en .gitignore).
# Genera secretos con: openssl rand -base64 32

DOMAIN=tu-dominio.com

# Origen del panel de monitoreo (separar con comas si hay varios)
DASHBOARD_ORIGIN=

DB_USER=glopsy
DB_PASSWORD=genera-una-contrasena-fuerte
DB_NAME=glopsy

JWT_SECRET=genera-uno-con-openssl-rand-base64-32
APP_ENC_KEY=genera-uno-con-openssl-rand-base64-32

# Cookies httpOnly con Secure (https). Dejar como true.
COOKIE_SECURE=true
# Modo multi-tienda: para compartir la sesión del comprador entre subdominios
# (<tienda>.glopsy.shop) fija el dominio de la cookie del sitio raíz.
# COOKIE_DOMAIN=glopsy.shop

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://glopsy-back.onrender.com/api/auth/google/callback

# Discord OAuth
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://glopsy-back.onrender.com/api/auth/discord/callback

# TikTok OAuth (Login Kit). Client Key = app key en TikTok for Developers.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.glopsy.shop/api/auth/tiktok/callback

# Integraciones (opcionales según lo que uses)
ENVIA_TOKEN=
ENVIA_SHIPPING_API_PROD=
MASTERSHOP_API_URL=

# Google Analytics 4 (usuarios activos en tiempo real para el monitor)
# Requiere: cuenta de servicio en Google Cloud con acceso al property GA4
# y la API "Google Analytics Data API" habilitada.
GA4_PROPERTY_ID=
GA4_CLIENT_EMAIL=
GA4_PRIVATE_KEY=

# Web Push (VAPID) — si no se definen, se usan/generan en config/vapid.json
# Genera con: node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# Motor de Marketing (IA opcional sobre reglas)
# Si no defines DEEPSEEK_API_KEY, el motor funciona SOLO con reglas
# (SEO, promociones, social y email/push) sin llamar a ninguna IA.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_MS=8000

# Worker del motor de marketing (análisis automático del catálogo)
# Desactiva con MARKETING_WORKER=off
MARKETING_WORKER=on
MARKETING_INTERVAL_HOURS=6
MARKETING_MAX_PROMOS=8

