{
  "name": "glopsy",
  "compatibility_date": "2026-08-22",
  "main": "./worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE_VERSIONS",
      "id": "a7c4f45652c44bb3a5b6b8c3b016f2dc"
    }
  ]
}
