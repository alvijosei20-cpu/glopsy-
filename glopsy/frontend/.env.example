# API base (proxy nginx /api -> backend). No cambiar en producción.
VITE_API_URL=/api

# Dominios raíz (multipaís), separados por coma. Cada tienda vive en
# <slug>.<root> según el país de la tienda. app/www.<root> es el marketplace.
VITE_ROOT_DOMAINS=glopsy.shop,glopsy.com.ve
# Compatibilidad (un solo dominio): VITE_ROOT_DOMAIN=glopsy.shop

# Google Analytics 4 (Measurement ID)
VITE_GA_MEASUREMENT_ID=G-HQF14269NQ
