# Copia este archivo a .env en el servidor y completa los valores reales.
# docker compose lo lee automáticamente (el .env real está en .gitignore).
# Genera secretos con: openssl rand -base64 32

DOMAIN=tu-dominio.com

# Origen del panel de monitoreo (separar con comas si hay varios)
DASHBOARD_ORIGIN=

DB_USER=glopsy
DB_PASSWORD=genera-una-contrasena-fuerte
DB_NAME=glopsy

JWT_SECRET=genera-uno-con-openssl-rand-base64-32
APP_ENC_KEY=genera-uno-con-openssl-rand-base64-32

# Cookies httpOnly con Secure (https). Dejar como true.
COOKIE_SECURE=true

# Integraciones (opcionales según lo que uses)
ENVIA_TOKEN=
ENVIA_SHIPPING_API_PROD=
MASTERSHOP_API_URL=
